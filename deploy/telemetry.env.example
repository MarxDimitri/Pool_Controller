# Pool Marx — Telemetrie-Zugangsdaten (Vorlage, OHNE echte Werte)
#
# Auf dem Pi ablegen als /etc/pool_marx/telemetry.env:
#   sudo install -m 600 -o pi -g pi telemetry.env.example /etc/pool_marx/telemetry.env
#   sudo nano /etc/pool_marx/telemetry.env
# Danach in config.yaml telemetry.enabled: true setzen und den Dienst neu starten.
# Fehlt die Datei, startet der Dienst trotzdem (EnvironmentFile=- in der Unit).
# Format: KEY=wert — keine Anführungszeichen, keine Leerzeichen um "=".

# Variante A — direkt an Elastic (ohne Collector):
#OTEL_EXPORTER_OTLP_ENDPOINT=https://<dein-projekt>.ingest.<region>.elastic.cloud:443
# Leerzeichen als %20 schreiben (OTel-Spezifikation):
#OTEL_EXPORTER_OTLP_HEADERS=Authorization=ApiKey%20<base64-api-key>

# Variante B — über den lokalen Collector (empfohlen, siehe scripts/otelcol-pi.yaml):
#OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
