# Pool Marx — Secrets (Vorlage)
#
# Auf dem Pi ablegen als /etc/pool_marx/secrets.env:
#   sudo install -d -m 700 /etc/pool_marx
#   sudo install -m 600 -o root -g root secrets.env.example /etc/pool_marx/secrets.env
#   sudo nano /etc/pool_marx/secrets.env
#
# systemd liest die Datei als root und übergibt die Werte als
# Umgebungsvariablen an den Dienst (siehe deploy/pool_marx.override.conf).
# Format: KEY=wert  — keine Anführungszeichen, keine Leerzeichen um "=".

# Passwort für das Web-Dashboard / API (mind. 12 Zeichen).
# Leer oder fehlend → Web-Steuerung gesperrt, Automatik läuft weiter.
POOL_API_SECRET=

# Zugangsdaten für den MQTT-Broker (Mosquitto)
POOL_MQTT_PASSWORD=
# optional, überschreibt mqtt.username aus config.yaml
#POOL_MQTT_USERNAME=pool
