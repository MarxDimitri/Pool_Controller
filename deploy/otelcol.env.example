# Zugangsdaten für den Collector (scripts/otelcol-pi.yaml) — Vorlage OHNE echte Werte
#
#   sudo install -m 600 -o root -g root otelcol.env.example /etc/pool_marx/otelcol.env
#   sudo nano /etc/pool_marx/otelcol.env
# (systemd liest die Datei als root, der Collector selbst läuft als otelcol-contrib)

ELASTIC_OTLP_ENDPOINT=https://<dein-projekt>.ingest.<region>.elastic.cloud:443
ELASTIC_OTLP_AUTH=ApiKey <base64-api-key>
